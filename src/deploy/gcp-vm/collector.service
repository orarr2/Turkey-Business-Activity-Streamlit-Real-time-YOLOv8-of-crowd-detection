[Unit]
Description=Business Activity - Live Footfall — collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__/src
Environment=PYTHONUNBUFFERED=1
# Two OpenMP threads matches the e2-micro's 2 shared vCPUs; torch's default
# oversubscribes and the context-switch thrash slows every YOLO pass down.
Environment=OMP_NUM_THREADS=2
# glibc grows one malloc arena per thread by default; on a threaded python
# process that quietly costs 50-150 MB of RSS - real money on a 1 GB host
# that was observed being taken down by the KERNEL oom-killer at 696M peak.
Environment=MALLOC_ARENA_MAX=2
Environment=FIREBASE_CREDENTIALS=__SA_PATH__
Environment=FIREBASE_STORAGE_BUCKET=__STORAGE_BUCKET__
# Optional Cloudflare-Worker relay for the IBB CDN (Istanbul cams). When
# /etc/turkey-footfall/proxy.env exists it should carry:
#   IBB_PROXY_URL=https://ibb-proxy.<sub>.workers.dev
#   IBB_PROXY_SECRET=<shared-secret>
# Without the file the collector runs unchanged - IBB stays 403 from GCP
# and the Turkey grid depends on the YouTube tier only. See
# deploy/cloudflare-proxy/README.md for the 5-minute setup.
EnvironmentFile=-/etc/turkey-footfall/proxy.env
# OSNet re-identification embedder. When the ONNX file is present the
# collector + dashboard-server use semantic identity matching (~5-10 ms
# per crop on CPU); when it's absent, both fall back to the HSV histogram
# transparently. Run `bash tools/setup_reid.sh` after `git pull` to fetch
# the model - it's a one-shot ~5 MB download and safe to skip if you're
# happy with the color-signature baseline.
Environment=REID_MODEL=__INSTALL_DIR__/src/data/osnet_x0_25_msmt17.onnx
# fix1 (2026-08-09): opt-in extra COCO classes - bags feed the
# unattended-object watch, animals and cafe parasols get their own counts
# ("other objects" line in the report). Detection-only: never the training
# chain. Night gates apply automatically (night_adjusted_conf is generic).
Environment=EXTRA_CLASSES=bird:0.35,dog:0.35,cat:0.40,backpack:0.35,handbag:0.40,suitcase:0.35,umbrella:0.35
# fix1-A11: a person loiter event triggers ONE pose pass on that person's
# crop; horizontal torso upgrades the alert to "Possible FALL". Lazy-loaded
# on first use only - person loiters are budgeted 10/day/cam.
Environment=FALL_CHECK=1
ExecStart=__INSTALL_DIR__/src/.venv/bin/python -m app.collector --weights yolov8s.pt --interval 40 --imgsz 640 --burst 2 --burst-stride 13
# --weights yolov8s.pt --imgsz 640 (2026-08-05, measured on the live VM):
#   * the nano@512 era (below) was an OOM fix from the 5-camera + burst-3
#     days; with 4 cams + burst 2 the service sits at ~410M RSS with 96-100%
#     CPU idle (load avg 0.03) - the machine was doing ~0.8s of model work
#     per 40s round while person counts read 0 on visibly crowded plazas
#     (Sarachane peaked at 0 people in seven straight digests);
#   * bench on this host, per 1080p pass: n@512 0.10s | n@640 0.15s |
#     n@768 0.20s | s@512 0.26s | s@640 0.39s. s@640 x2 frames x4 cams
#     = ~3s model time per round, still <8% of the interval;
#   * same live frames, s@640 vs the old n@512: Taksim 5 people vs 0,
#     Sarachane 7 vehicles vs 0. The undercount was the config, not the
#     cameras.
# FALLBACK if journal shows MemoryHigh pressure or oom-kills: drop to
# `--weights yolov8n.pt --imgsz 768` (n@768 = 0.20s/pass, no RAM growth
# vs n@512 worth mentioning) before touching anything else.
# --interval 40s: 4 slots x 2 writes/round - the cadence is bounded by the
# Firestore free write quota (~17.3k/day of 20k at 40s), not by CPU.
#
# History - the nano@512 era (2026-07, 5 cameras + OSNet + burst 3):
#   * 640/burst-3 with FIVE cams pushed RSS past MemoryMax and the service
#     entered a 4-minute oom-kill loop while rounds stretched past 7 min;
#   * burst 2 @ stride 13 keeps two frames ~0.5s apart - the median still
#     kills single-frame flicker and the speed estimator still gets its
#     two points (detect_core also picks the ~720p rendition of the master
#     playlist instead of decoding 1080p).
# On a host with more RAM (e2-small = 2 GB and up), raise to
# `--imgsz 960 --burst 3 --burst-stride 25` for the last bit of recall.
Restart=always
RestartSec=15
# Memory sizing for the e2-micro (1 GB, Always Free) this project runs on.
# High/Max raised from 700/850 after the oom-kill loop above: the OSNet
# session + fifth camera legitimately need the headroom, and the flag
# changes on ExecStart pull peak RSS back down at the same time. If the
# journal shows oom-kills again, drop back to `--weights yolov8n.pt` or
# move to e2-small.
MemoryHigh=760M
MemoryMax=900M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
